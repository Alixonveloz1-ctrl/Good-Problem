# Local development. In Cloud Run these come from the service configuration and
# there is never a credential among them: the attached service account provides
# identity through Application Default Credentials (PRD 40).

# Leave AAUS_PROJECT_ID empty to run fully local: in-memory Firestore, files on
# disk, no Google Cloud call at all.
AAUS_PROJECT_ID=
AAUS_LOCATION=us-central1

# Empty means no access gate, which is what a laptop needs. In production this
# is the owner's Google account, and the three below are what let them in.
AAUS_OWNER_EMAIL=

# Firebase web config as JSON, exactly as its API returns it: apiKey,
# authDomain, projectId. Not a secret — it is meant to go in the browser.
# setup.sh reads it from Google and sets it; nobody copies it by hand.
AAUS_FIREBASE_CONFIG=

# Signs the session cookie. setup.sh generates it; 32+ characters or the app
# refuses to start with a gate configured.
AAUS_SESSION_SECRET=

# true never calls a paid API. Production sets it to false explicitly.
AAUS_DRY_RUN=true

AAUS_BUCKET=
AAUS_TASKS_QUEUE=
AAUS_TASKS_TARGET_URL=
AAUS_TASKS_SERVICE_ACCOUNT=
